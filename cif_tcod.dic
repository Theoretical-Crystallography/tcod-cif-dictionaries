    loop_ _enumeration
        VCA                    'describe the corresponding method here'
        CPA                    'describe the corresponding method here'
        SQS                    'describe the corresponding method here'
        'real space recursion' 'describe the corresponding method here'
        other                  'alloy method not one of the mentioned above'
