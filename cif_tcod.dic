          LDA                    'describe the corresponding functional here'
          GGA                    'describe the corresponding functional here'
          meta-GGA               'describe the corresponding functional here'
          Hybrid                 'describe the corresponding functional here'
          ACFD-RPA               'describe the corresponding functional here'
          'orbital functional'   'describe the corresponding functional here'
          'exact exchange'       'describe the corresponding functional here'
          vdW-DF                 'describe the corresponding functional here'
          LDA/GGA+U/DMFT         'describe the corresponding model here'
          'orbital polarization' 'describe the corresponding model here'
          other                  'model not one of the mentioned above'
    _definition
; PLEASE ADD HUMAN-READABLE DESCRIPTION HERE
;

