data_tcod_model_ff_type
    _name '_model_ff_type'
    _type char
    loop_ _enumeration
          _enumeration_detail
          Fixed-charge           'describe the corresponding functional here'
          Polarizable            'describe the corresponding functional here'
          Distributed-multipole  'describe the corresponding functional here'
          Hybrid                 'describe the corresponding functional here'
          Reactive               'describe the corresponding functional here'
          other                  'functional not one of the mentioned above'
    _definition
; Fixed charge (standard biomolecular and materials: amber, opls, gromos etc.)
  Polarizable (AMOEBA, iAMOEBA etc.)
  Distributed multipole based FFs (multipoles instead of fixed point charges
  S. Price et al.)
  Hybrid (Different types for interatomic and intraatomic interactions)  
  Reactive (ReaxFF etc.)
  L.V. The list is non-exhaustive
;

data_tcod_model_ff_name
    _name '_model_ff_name'
    _type char
    _definition
; Standard name for the FF used. If there is no standard name use 'custom'
  Examples: charmm, opls, amber, gromos etc.
;

data_tcod_model_ff_version
    _name '_model_ff_version'
    _type char
    _definition
; Version of a force field. Usually year of the publication.  
;     

