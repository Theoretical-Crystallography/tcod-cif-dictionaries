###############################################################################
# Content encodings used for the files:
###############################################################################

data_tcod_content_encoding_[]
_name '_tcod_content_encoding_[]'
_category category_overview
_type null
loop_ _example
      _example_detail
;
    loop_
    _tcod_content_encoding_id
    _tcod_content_encoding_layer_id
    _tcod_content_encoding_layer_type
    gzip+base64 1 gzip
    gzip+base64 2 base64
;
;
    Example 1 - based on TCOD entry 10000001
                (http://www.crystallography.net/tcod/10000001.cif@267).
                Presents an encoding stack for gzip+base64, where data is
                gzipped first and base64-encoded second.
;

data_tcod_content_encoding_id
_name '_tcod_content_encoding_id'
_category tcod_content_encoding
_type char
_list yes
_list_link_child '_tcod_file_content_encoding'
_list_mandatory yes

data_tcod_content_encoding_layer_id
_name '_tcod_content_encoding_layer_id'
_category tcod_content_encoding
_type numb
_list yes
_list_mandatory yes
_list_uniqueness '_tcod_content_encoding_id'
_enumeration_range 1:
_definition
; One-based number of an encoding layer in the encoding stack,
starting from the innermost layer.
;

data_tcod_content_encoding_layer_type
_name '_tcod_content_encoding_layer_type'
_category tcod_content_encoding
_type char
_list yes
_list_mandatory yes
_list_reference '_tcod_content_encoding_id'
loop_
_enumeration
_enumeration_detail
    ncr                 'Numeric Character Reference'
    base64              'Base64 as described in RFC2045'
    quoted-printable    'Quoted-printable as described in RFC2045'
    gzip                'Gzip as described in RFC1952'

