###############################################################################
# Overal method description:
###############################################################################

data_tcod_method_[]
    _name '_tcod_method_[]'
    _category category_overview
    _type null

data_tcod_structure_type
    _name '_tcod_structure_type'
    _category tcod_method
    _type char
    loop_ _enumeration
          _enumeration_detail

          crystal-ground-state
              'refined crystal structure at ground state'

          crystal-excited-state 
              'refined crystal structure at some excited state, e.g. LUMO'

          crystal-metastable
              'metastable structure that is short lived'

          crystal-soft-phonon
              'dynamically disorderd, unstable structures'

          crystal-transition-state
              'molecular structure in a sort-lived reaction transition-state'

          vacuum-ground-state
              'refined crystal structure at ground state'

          vacuum-excited-state 
              'refined crystal structure at some excited state, e.g. LUMO'

          vacuum-metastable
              'metastable structure that is short lived'

          vacuum-transition-state
              'molecular structure in a sort-lived reaction transition-state'

    _definition
;
    This data item specifies what kind of computationally optimised
    structure does the file record. Structures that record stable
    crystal polymorphs with long time-lifes (i.e. time lifes much
    longer than duration of a typical diffraction experiment) are
    'ground-state'; however, short-lived structures that can be
    refined with the help of DFT or other methods can be included into
    TCOD, but must be tagged accordingly.

    Possibly, we can classify structures by their half-lifes at
    certain temperatures.
;

#------------------------------------------------------------------------------
#     Computational evaluation of an existing crystal structure
#------------------------------------------------------------------------------

data_tcod_model
    _name '_tcod_model'
    _category tcod_method
    _type char
    loop_ _enumeration
          _enumeration_detail
          DFT                  'describe the corresponding model here'
          HF                   'describe the corresponding model here'
          MP2                  'describe the corresponding model here'
          CI                   'describe the corresponding model here'
          CC                   'describe the corresponding model here'
          MI                   'describe the corresponding model here'
          SAPT                 'describe the corresponding model here'
          QMC                  'describe the corresponding model here'
          DFTB                 'describe the corresponding model here'
          Semi-empirical       'describe the corresponding model here'
          FF                   'describe the corresponding model here'
          CG                   'describe the corresponding model here'
          other                'description should be provided in the data CIF'
    _definition
;

  S.G. 2016-10-28: FIXME:

  -- merge with the NOMAD 'Electronic structure method';

  -- add indication that this data item is related to the NOMAD
     'Electronic structure method';

  -- see also: NOMAD 'calcuation_method'

  This should define the theoretical model used to calculate the
  structure.

  L.V. The list is by no means exhaustive and should be constantly
  updated.

  Main classes of models: DFT, ab initio (post-Hartree-Fock:
  Moeller-Plesset (MPx), Configuration Interaction (CI), coupled
  cluster (CC), Quantum Monte Carlo (QMC), Symmetry-adapted
  perturbation theory (SAPT), semi-empirical (OF-DFT, DFTB, NDDO,
  MINDO etc.), force field (empirical), coarse-grained
  (non-atomistic).
  
  Keywords: DFT (Density model theory), HF (Hartree-Fock), MPn
  (Moller-Plesset) perturbation theory, e.g. local MP2 by Kresse,
  Schutz, Scuseria etc.), MI (Method of increments by H. Stoll et
  al.), CC (Periodic coupled cluster e.g. by Gr\"uneis et al.), QMC
  (Quantum Monte Carlo by Ceperley, Mitas, Recently FCI-QMC by Alavi
  et al.), Orbital-free DFT (E. Carter et al.), DFTB (Density model
  tight binding by Seifert, Frauenheim etc.), Semi-empirical methods,
  Force field models (fixed charged, polarizable, distributed
  multipoles etc.), Coarse-grained models (e.g. Martini)

  L.V. Tried to compile a short list of methods used for periodic
  calculations

  L.V. in principal one should also define a class for hybrid models
  (QM/MM)
 
  One can add a human-readable description of the mehtod here as well
  as the reference.

  L.V. Is it possible to add full cif syntax to define the reference?
  S.G. Yes, done in the ..._citation_id and _tcod_citation_linkage
  data items.
;

###############################################################################
# TCOD bookkeeping tags
###############################################################################

data_tcod_database_[]
    _name                      '_tcod_database_[]'
    _category                    category_overview
    _type                        null
    loop_ _example
          _example_detail
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;   _tcod_database_code 10000001
;
;
    Example 1 - based on TCOD entry 10000001.cif, revision 267
                svn://www.crystallography.net/tcod/cif/10/00/00/10000001.cif
                http://www.crystallography.net/tcod/10000001.cif
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    _definition
;              Data items from this category are used for TCOD bookkeeping
               records, such as assigned TCOD number (aka TCOD database code).
;

#------------------------------------------------------------------------------

data_tcod_database_code
    _name                      '_tcod_database_code'
    _category                    tcod_database
    _type                        numb
    _list                        no
    _definition
;              Specifies TCOD number assigned upon deposition into TCOD to the
               crystal structure described in the CIF.
;

#-------------------------------------------------------------------------------

data_tcod_data_source_[]
    _name                      '_tcod_data_source_[]'
    _category                    category_overview
    _type                        null
    _definition
;               Data items from this category are used to
                record and trace sources of information deposited into TCOD.
;

#-------------------------------------------------------------------------------

data_tcod_data_source_file
    _name                      '_tcod_data_source_file'
    _category                    tcod_data_source
    _type                        char
    _list                        no
    _definition
;         Specifies file name of the file that served as a source of data in
          this TCOD entry. The file should be recoded without the path or
          other URL components, since these components usually have no sense
          on the recipient's system. In Unix parlance, the value recorded
          should be the basename of the original file. For many data
          sources, however, the basename contains enough information to
          locate the original source. For instance, CIFs published in IUCr
          journals have Coeditor Code as a CIF file name, permitting to
          identify the original paper where the structure is
          discussed. Other journals may used original article's DOI as a part
          of the filename for the supplementary CIF file, which also permits
          one to trace back the original paper.
;

#------------------------------------------------------------------------------

data_tcod_data_source_block
    _name                      '_tcod_data_source_block'
    _category                    tcod_data_source
    _type                        char
    _list                        no
    _definition
;         Specifies the name of the data block within the file specified in
          the _tcod_data_source_file tag that served as a source of data in
          this TCOD entry. Only the data block name following the 'data_'
          header keyword should be recorded, not the whole data block
          header; i.e. the value specified here should be 'I', *not*
          'data_I', for a data block with the header 'data_I'.
;

###############################################################################
# Identification of the source database record for the structure
###############################################################################

data_tcod_source_structure_database_[]
    _name                      '_tcod_source_structure_database_[]'
    _category                    category_overview
    _type                        null

data_tcod_source_structure_database_uuid
    _name                      '_tcod_source_structure_database_uuid'
    _category                    tcod_source_structure_database
    _type char
    _definition
; UUID (Universally Unique Identifier,
http://en.wikipedia.org/wiki/Universally_unique_identifier) of the
database output structure (node, record) that was exported to this entry.
;

data_tcod_source_structure_database_id
    _name                      '_tcod_source_structure_database_id'
    _category                    tcod_source_structure_database
    _type                        char

data_tcod_source_structure_database_URI
    _name                      '_tcod_source_structure_database_URI'
    _category                    tcod_source_structure_database
    _type                        char

data_tcod_source_structure_database_version
    _name                      '_tcod_source_structure_database_version'
    _category                    tcod_source_structure_database
    _type                        char

###############################################################################
# Identification of the source database
###############################################################################

data_tcod_source_database_[]
    _name                      '_tcod_source_database_[]'
    _category                    category_overview
    _type                        null

data_tcod_source_database_name
    _name                      '_tcod_source_database_name'
    _category                    tcod_source_database
    _type                        char
    _definition
; A name of a database that was used to produce (to compute) this
structure.

Example:

_tcod_source_database_name AiiDA
;

data_tcod_source_database_URI
    _name                      '_tcod_source_database_URI'
    _category                    tcod_source_database
    _type                        char
    _definition
; A (stable) URI (or URL) of the database Web site describing the
database that produced the structure.

Example:

_tcod_source_database_URI http://www.aiida.net/
;

data_tcod_source_database_version
    _name                      '_tcod_source_database_version'
    _category                    tcod_source_database
    _type                        char
    _definition
; A version of the database that produced a structure under consideration.

Example:

_tcod_source_database_version 1.0
;

###############################################################################
# Definition of the simulation cell:
###############################################################################

data_tcod_atom_sites_sim_cell_tran_matrix_
    loop_ _name                '_tcod_atom_sites_sim_cell_tran_matrix_11'
                               '_tcod_atom_sites_sim_cell_tran_matrix_12'
                               '_tcod_atom_sites_sim_cell_tran_matrix_13'
                               '_tcod_atom_sites_sim_cell_tran_matrix_21'
                               '_tcod_atom_sites_sim_cell_tran_matrix_22'
                               '_tcod_atom_sites_sim_cell_tran_matrix_23'
                               '_tcod_atom_sites_sim_cell_tran_matrix_31'
                               '_tcod_atom_sites_sim_cell_tran_matrix_32'
                               '_tcod_atom_sites_sim_cell_tran_matrix_33'
    _category                    atom_sites
    _type                        numb
    _definition
;

              Matrix elements used to transform fractional coordinates
               in the ATOM_SITE category to fractional coordinates in
               the simulation cell. The 3 x 1 translation
               is defined in _atom_sites_sim_cell_tran_vector_*.

                 x'   fractional      |11 12 13|      x   fractional     | 1 |
               ( y' ) simulation   =  |21 22 23|    ( y ) conventional + | 2 |
                 z'   cell coords     |31 32 33|      z   cell coords    | 3 |
;

data_tcod_atom_sites_sim_cell_tran_vector_
    loop_ _name                '_tcod_atom_sites_sim_cell_tran_vector_1'
                               '_tcod_atom_sites_sim_cell_tran_vector_2'
                               '_tcod_atom_sites_sim_cell_tran_vector_3'
    _category                    atom_sites
    _type                        numb
    _definition
;              Elements of a 3 x 1 translation vector used in the
               transformation of fractional coordinates in the
               ATOM_SITE category to simulation cell coordinates.

                 x'                   |11 12 13|      x                  | 1 |
               ( y' ) simulation  =   |21 22 23|    ( y ) fractional  +  | 2 |
                 z'                   |31 32 33|      z                  | 3 |
;

###############################################################################
# Software and computational facility description
###############################################################################

data_tcod_software_[]
    _name                      '_tcod_software_[]'
    _category                    category_overview
    _type                        null

data_tcod_software_package
    _name '_tcod_software_package'
    _category tcod_software
    _type char
    _definition
; Software package used to compute and produce the DFT-computed structure file.
  Only package or program name should be used, e.g. 'VASP', 'psi3', 'Abinit', etc.
;

data_tcod_software_package_version
    _name '_tcod_software_package_version'
    _category tcod_software
    _type char
    _definition
; Software package version used to compute and produce the computed
  structure file. Only version designator should be used, e.g. '3.4.0',
  '2.1rc3'. It is desireable that the combination of the _tcod_software_package
  and _tcod_software_package_version values would uniquely identify the code
  that was used for computations.
;

data_tcod_software_package_compilation_timestamp
    _name '_tcod_software_package_compilation_date'
    _category tcod_software
    _type char
    _example     2014-11-04T13:49:49.290475Z
    _definition
; ISO 8601 (http://en.wikipedia.org/wiki/ISO_8601) format timestamp of
  the time when the executable was compiled.

  Should correspond to the
  http://www.xml-cml.org/dictionary/compchem/#compileDate data
  element, but MUST be expressed in the ISO standard format.
;

data_tcod_software_package_compilation_environment
    _name '_tcod_software_package_compilation_environment'
    _category tcod_software
    _type char
    _definition
; A set of environment variable definitions, in /bin/sh syntax
(i.e. using the "NAME=VALUE" syntax) for all relevant environment
variables that were active when compiling this package. You can get the
list in this syntax from the Unix/Linux 'printenv' command.
;

data_tcod_software_package_binary_uri
    _name '_tcod_software_package_binary_uri'
    _category tcod_software
    _type char
    _definition
; An URI (Web reference) where the binary package of the software used
for this computation can be fetched.
;

data_tcod_software_package_source_uri
    _name '_tcod_software_package_source_uri'
    _category tcod_software
    _type char
    _definition
; An URI (Web reference) where the source code package of the software
used for this computation can be fetched.
;

data_tcod_software_executable_path
    _name '_tcod_software_executable_path'
    _category tcod_software
    _type char
    _definition
; The file-system path to the executable that was run for this
computation.
;

data_tcod_software_runtime_OS
    _name '_tcod_software_runtime_OS'
    _category tcod_software
    _type char
    _definition
; Operating system used to compute and produce the DFT-computed structure file.
  Only OS name should be used, e.g. 'Irix', 'Windows XP', 'Ubuntu GNU/Linux',
  etc.
;

data_tcod_software_runtime_OS_version
    _name '_tcod_software_OS_version'
    _category tcod_software
    _type char
    _definition
; Operating system version used to compute and produce the
  DFT-computed structure file.  Only version designator should be
  used, e.g. '3.4.0', '2.1rc3'. It is desireable that the combination
  of the _dft_software_operating_system and
  _dft_software_package_operating_system_version values would uniquely
  identify the OS that was used for computations.
;

data_tcod_software_OS_compilation_timestamp
    _name '_tcod_software_OS_compilation_date'
    _category tcod_software
    _type char
    _example     2014-11-04T13:49:49.290475Z
    _definition
; ISO 8601 (http://en.wikipedia.org/wiki/ISO_8601) format timestamp of
  the time when the operating system image was compiled.
;

data_tcod_software_runtime_OS_binary_uri
    _name '_tcod_software_runtime_OS_binary_uri'
    _category tcod_software
    _type char
    _definition
; An URI (Web reference) where the binary image (e.g. an ISO file, or
a virtual machine image) of the operating system on which computations
were peformed can be fetched.
;

data_tcod_software_runtime_OS_source_uri
    _name '_tcod_software_runtime_OS_source_uri'
    _category tcod_software
    _type char
    _definition
; An URI (Web reference) where the source code of the operating system
on which computations were peformed can be fetched.
;

data_tcod_software_runtime_CPU
    _name '_tcod_software_runtime_CPU'
    _category tcod_software
    _type char
    _definition
; Name (type) of the central processing unit (CPU), together with the 
  floating-point processing unit, that was used to compute the results.
;

data_tcod_software_runtime_CPU_version
    _name '_tcod_software_runtime_CPU_version'
    _category tcod_software
    _type char
    _definition
; Version or release number of the central processing unit (CPU),
  together with the floating-point processing unit, that was used to 
  compute the results.
;

# S.G. If needed, a compile time, CPU, CPU version and OS data items
# will be defined -- in case we will have cross-compiled packages.

data_tcod_software_compiler
    _name '_tcod_software_compiler'
    _category tcod_software
    _type char
    _definition
; The compiler which compiled the code used for the described
calcualtion. Only the compiler name should be given, e.g. 'gcc',
'icc', 'gfortran'.

If more than one compiler was used, these items must be looped.
;

data_tcod_software_compiler_version
    _name '_tcod_software_compiler_version'
    _category tcod_software
    _type char
    _definition
; A version string (number) of the compiler used to compile the code for this
computation.
;

data_tcod_software_compiler_options
    _name '_tcod_software_compiler_options'
    _category tcod_software
    _type char
    _definition
; A string with all options that were used to compile the given package.
;

###############################################################################
# Description of software libraries
###############################################################################

data_tcod_software_library_[]
    _name '_tcod_software_library_[]'
    _type null
    _category category_overview
    _definition
; Describes computational libraries.
;

data_tcod_software_library_id
    _name '_tcod_software_library_id'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; Identifies a software library in a loop
;

data_tcod_software_library
    _name '_tcod_software_library'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; The subroutine library (e.g. linear algebra) that was linked with
the code used for the described calculation. Only the library name
should be given, e.g. 'pthreads', 'libc', 'lapack'.

If more than one library was used, these items must be looped.
;

data_tcod_software_library_version
    _name '_tcod_software_library_version'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; A version string (number) of the library linked with the code for this
computation.
;

data_tcod_software_library_compilation_timestamp
    _name '_tcod_software_library_compilation_date'
    _type char
    _category tcod_software_library
    _list yes
    _example     2014-11-04T13:49:49.290475Z
    _definition
; ISO 8601 (http://en.wikipedia.org/wiki/ISO_8601) format timestamp of
  the time when the subroutine library file was compiled.
;

data_tcod_software_library_compilation_environment
    _name '_tcod_software_library_compilation_environment'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; A set of environment variable definitions, in /bin/sh syntax
(i.e. using the "NAME=VALUE" syntax) for all relevant environment
variables that were active when compiling this library. You can get the
list in this syntax from the Unix/Linux 'printenv' command.
;

data_tcod_software_library_compiler_name
    _name '_tcod_software_library_compiler_name'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; Library compiler name (same syntax as for a package compiler).
;

data_tcod_software_library_compiler_version
    _name '_tcod_software_library_compiler_version'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; Library compiler version (same syntax as for a package compiler).
;

data_tcod_software_library_compiler_options
    _name '_tcod_software_library_compiler_options'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; Library compiler options that were used (same syntax as for a
package compiler).
;

data_tcod_software_library_path
    _name '_tcod_software_library_path'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; A file sytem path of the library file (especially the shared
library, *.so or *.dll) linked with the code for this computation.
;

data_tcod_software_library_binary_uri
    _name '_tcod_software_library_binary_uri'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; An URI (Web reference) where the binary software library used for
this computation can be fetched.
;

data_tcod_software_library_source_uri
    _name '_tcod_software_library_source_uri'
    _type char
    _category tcod_software_library
    _list yes
    _definition
; An URI (Web reference) where the source code software library used for
this computation can be fetched.
;

#------------------------------------------------------------------------------
# L.V. I don't think that things like operating system, cpu type, runtime are 
# relavant for TCOD, as discussed, in that case one should also report: compiler
# version, algebra libraries etc.
# 
# S.G. I think it would be good to have data items to describe such
# metadata; on one hand, a user might be interested in the computation
# facilities used for the calculations, if only to plan his/her own
# setup; on the other hand, one might need such information to hunt
# down CPU or computer bugs (recall the infamous Pentium FDIV
# bug...). The bugs might, in theory, influence computation results
# and conclusions. The information is easy to gather at the point of
# computation, so we need to provide means to record it. The relevan
# data items will be inserter.
#------------------------------------------------------------------------------

###############################################################################
# Initial data
###############################################################################

###############################################################################
# Initial atomic coordinate source
###############################################################################

data_tcod_initial_coordinate_[]
    _name '_tcod_initial_coordinate_[]'
    _type null
    _category category_overview
    _definition
; Initial atomic coordinate source.
;

data_tcod_initial_coordinate_db_name
_name '_tcod_initial_coordinate_db_name'
_type char
_category tcod_initial_coordinate
_definition
; Coordinate source database name (e.g. "Crystallography Open Database")
;

