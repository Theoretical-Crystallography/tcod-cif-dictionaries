###############################################################################
# Electron counts
###############################################################################

data_dft_cell_valence_electrons
    _name '_dft_cell_valence_electrons'
    _type numb
    _enumeration_range 1:
    _definition
; Total number of electrons in calculation.
;

data_dft_core_electrons
    _name '_dft_core_electrons'
    _type numb
    _enumeration_range 1:
    _definition
; Total number of core electrons in calculation
;

###############################################################################
# Pseudopotentials
###############################################################################

data_dft_pseudopotential_type
    _name '_dft_pseudopotential_type'
    _type char
    loop_ _enumeration
          _enumeration_detail
          NCPP      'describe the corresponding pseudopotential here'
          USPP      'describe the corresponding pseudopotential here'
          PAW       'describe the corresponding pseudopotential here'
          other     'description should be given in the data CIF'
    _definition
; PLEASE ADD HUMAN-READABLE DESCRIPTION HERE
  L.V. Added by L.V.
;

data_dft_pseudopotential_type_other_name
    _name '_dft_pseudopotential_type_other_name'
    _type char
    _definition
; Custom name of the pseudopotential if _dft_pseudopotential_type data item value
  is given as 'other'.
;

